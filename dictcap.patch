+void
+_PyDict_SetMaxSize(Py_ssize_t max_size)
+{
+    FT_ATOMIC_STORE_SSIZE_RELEASE(pvm_max_dict_size, max_size);
+}
+
+int
+_PyDict_CheckSizeLimit(Py_ssize_t size)
+{
+    Py_ssize_t limit = _PyDict_GetMaxSize();
+    if (limit > 0 && size >= limit) {
+        PyErr_SetString(PyExc_ValueError,
+                        "DictCapPVM: dictionary size limit exceeded");
+        return -1;
+    }
+    return 0;
+}
