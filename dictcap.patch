+static PyObject *
+sys_get_max_dict_size(PyObject *module, PyObject *Py_UNUSED(ignored))
+{
+    return PyLong_FromSsize_t(_PyDict_GetMaxSize());
+}
+
+static PyObject *
+sys_set_max_dict_size(PyObject *module, PyObject *limit_object)
+{
+    Py_ssize_t limit = PyLong_AsSsize_t(limit_object);
+    if (limit == -1 && PyErr_Occurred()) {
+        return NULL;
+    }
+    _PyDict_SetMaxSize(limit);
+    Py_RETURN_NONE;
+}
